<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>nexum-agent</AssemblyName>
    <RootNamespace>NexumAgent</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <!-- What Windows shows for this file (Task Manager, file properties): plain words, no internal names. -->
    <Product>Nexum</Product>
    <Company>Nexum</Company>
    <AssemblyTitle>Nexum sensor service</AssemblyTitle>
    <Description>Reads hardware sensors for Nexum</Description>

    <!-- Runs asInvoker; the elevated Tauri parent passes its token to the child. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Supports a self-contained single-file publish for win-x64
         (dotnet publish, Release, self-contained true, PublishSingleFile=true). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- MF-8: native runtime DLLs ship next to nexum-agent.exe (Program Files) instead of being
         extracted to a user-writable %TEMP%\.net folder that an elevated process would load from. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- LibreHardwareMonitorLib relies on reflection: trimming must stay off. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Low-overhead background process. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- Compression is only valid for self-contained single-file bundles. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true' And '$(PublishSingleFile)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real PresentMon 2.6.0 CSV header (CONTRACT §1.6.3); the agent self-test resolves every fatal column from it. -->
    <EmbeddedResource Include="Frames/HEADER-2.6.0.txt" LogicalName="NexumAgent.Frames.HEADER-2.6.0.txt" />
  </ItemGroup>

</Project>
