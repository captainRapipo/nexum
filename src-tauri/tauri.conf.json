{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexum",
  "mainBinaryName": "Nexum",
  "version": "1.2.0",
  "identifier": "net.nexum.monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nexum",
        "width": 1600,
        "height": 960,
        "minWidth": 1280,
        "minHeight": 800,
        "center": true,
        "resizable": true,
        "decorations": true,
        "theme": "Light",
        "backgroundColor": "#F5F5F7",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nexum",
    "copyright": "Copyright (c) 2026 Nexum",
    "category": "Utility",
    "shortDescription": "PC telemetry, drivers and cache cleanup",
    "longDescription": "Nexum is a hardware monitor for Windows 10/11: real-time CPU/GPU/RAM/fan telemetry, storage and S.M.A.R.T. health, a full driver and BIOS inventory with export and backup, opt-in frame-rate capture with Intel PresentMon, sensor logging to CSV, and a conservative cache cleanup with an audit log. No telemetry and no accounts: Nexum goes online only to ask GitHub whether a newer version exists, and to download it when you click Install. That check stays off until you agree.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/nexum-agent"],
    "resources": {
      "../build/agent/MonoPosixHelper.dll": "MonoPosixHelper.dll",
      "../build/agent/libMonoPosixHelper.dll": "libMonoPosixHelper.dll",
      "../build/presentmon/PresentMon-2.6.0-x64.exe": "presentmon/PresentMon-2.6.0-x64.exe",
      "../LICENSE": "LICENSE",
      "../licenses/": "licenses/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNENzc3OERFRDk0Qzc0QTYKUldTbWRFelozbmgzUFh5azMwYUR6bjF6MUNIU3dGNVRsRURvQnVVclZEL1FUc05PMVF1eTJKU2UK",
      "endpoints": ["https://github.com/captainRapipo/nexum/releases/download/updates/stable.json"],
      "requireSignedVersion": true
    }
  }
}
